{
  "name": "zoltbot",
  "version": "0.1.5",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm check:native && pnpm test && pnpm test:e2e",
    "check:native": "node scripts/build-keychain.mjs --check && node scripts/build-speech.mjs --check",
    "build:keychain": "node scripts/build-keychain.mjs",
    "build:speech": "node scripts/build-speech.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/mobile",
    "lint": "biome check . && node scripts/quality.mjs && node scripts/fixture-hygiene.mjs && pnpm check:boundary",
    "test": "vitest run",
    "format": "biome check --write .",
    "view:dev": "TSX_DISABLE_CACHE=1 node --import tsx scripts/view-dev.mjs",
    "view:schema": "TSX_DISABLE_CACHE=1 node --import tsx packages/view-api/generate.ts",
    "schema:generate": "TSX_DISABLE_CACHE=1 node --import tsx packages/protocol/generate.ts",
    "dev:daemon": "TSX_DISABLE_CACHE=1 node --import tsx packages/daemon/src/main.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "dev:ui": "vite --config packages/ui/vite.config.ts",
    "build:ui": "vite build --config packages/ui/vite.config.ts",
    "test:e2e": "pnpm build:desktop --fixtures && playwright test",
    "dev:desktop": "pnpm build:desktop && node scripts/launch-desktop.mjs",
    "theme:mobile": "TSX_DISABLE_CACHE=1 node --import tsx apps/mobile/scripts/build-theme.ts",
    "test:results": "playwright test --config tests/results/playwright.config.ts",
    "test:shipping": "playwright test --config playwright.shipping.config.ts",
    "test:compare": "playwright test --config playwright.compare.config.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "check:boundary": "node scripts/public-boundary.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@biomejs/biome": "2.4.6",
    "@playwright/test": "1.58.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.27.7",
    "js-tiktoken": "1.0.21",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "playwright-core": "1.58.1"
  }
}
