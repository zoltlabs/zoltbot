{
  "name": "@zoltbot/shell",
  "productName": "Zoltbot Shell",
  "version": "0.1.11",
  "description": "Zoltbot desktop shell, derived from OpenBot v0.1.11.",
  "author": {
    "name": "Norbert Bodziony",
    "url": "https://x.com/norbertbodziony"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ai-agents",
    "bun",
    "claude-code",
    "codex",
    "electron",
    "local-first",
    "solidjs"
  ],
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:renderer",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:feel": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@zoltbot/daemon": "workspace:*",
    "@zoltbot/protocol": "workspace:*",
    "solid-js": "1.9.14",
    "ws": "8.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.58.1",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.12"
  }
}
