{
  "name": "@zoltbot/shell",
  "productName": "Zoltbot Shell",
  "version": "0.1.11",
  "description": "Zoltbot desktop shell, derived from OpenBot v0.1.11.",
  "author": {
    "name": "Norbert Bodziony",
    "url": "https://x.com/norbertbodziony"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ai-agents",
    "bun",
    "claude-code",
    "codex",
    "electron",
    "local-first",
    "solidjs"
  ],
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "dev:reset": "node --import tsx scripts/reset-dev-state.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:renderer",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:backend": "vitest run src/backend",
    "test:browser": "node --import tsx scripts/browser-smoke.ts",
    "test:codex": "node --import tsx scripts/codex-doctor.ts --strict",
    "test:filesystem": "node --import tsx scripts/filesystem-smoke.ts",
    "test:imagegen": "node --import tsx scripts/filesystem-smoke.ts --imagegen",
    "codex:doctor": "node --import tsx scripts/codex-doctor.ts",
    "release:preflight": "node --import tsx scripts/release-preflight.ts",
    "release:patch": "node --import tsx scripts/prepare-release.ts patch",
    "release:minor": "node --import tsx scripts/prepare-release.ts minor",
    "release:major": "node --import tsx scripts/prepare-release.ts major",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:browser && pnpm run build",
    "package": "pnpm run build && electron-builder --dir --mac --arm64 --config.mac.identity=null --config.mac.notarize=false",
    "verify:package": "node --import tsx scripts/verify-macos-package.ts",
    "package:verify": "pnpm run package && pnpm run verify:package",
    "package:win": "pnpm run build && electron-builder --dir --win --x64 --publish never",
    "verify:package:win": "node --import tsx scripts/verify-windows-package.ts",
    "package:win:verify": "pnpm run package:win && pnpm run verify:package:win",
    "dist:mac": "pnpm run build && electron-builder --mac --arm64 --config.mac.identity=null --config.mac.notarize=false",
    "dist:win": "pnpm run build && electron-builder --win nsis --x64 --publish never",
    "dist:release": "pnpm run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.228",
    "electron-updater": "6.8.9",
    "solid-js": "1.9.14",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@electron/fuses": "1.8.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "^24.19.2",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-solid": "2.11.14",
    "vitest": "4.1.12"
  }
}
